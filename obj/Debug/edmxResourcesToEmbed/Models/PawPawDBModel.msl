    </EntitySetMapping>
    <EntitySetMapping Name="PersonnelTypes">
      <EntityTypeMapping TypeName="PawPawDBModel.PersonnelType">
        <MappingFragment StoreEntitySet="PersonnelTypes">
          <ScalarProperty Name="PersonnelTypeName" ColumnName="PersonnelTypeName" />
