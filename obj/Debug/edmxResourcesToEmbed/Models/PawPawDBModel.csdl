  </EntityType>
  <EntityType Name="PersonnelType">
    <Key>
      <PropertyRef Name="PersonnelTypeId" />
    </Key>
    <Property Name="PersonnelTypeId" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
