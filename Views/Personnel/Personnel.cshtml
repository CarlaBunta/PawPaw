@model PawPaw.ViewModel.PersonnelViewModel
@{
    ViewBag.Title = "Personnel";
}
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script type="text/javascript">
    $(document).ready(function(){
        $("#btnSave").click(function() {
            SavePersonnelData();
        });
    });

    function LoadPersonnelDetails() {
        //$("#divLoadPersonnelDetails")

        $.ajax({
            async: true,
            data: 'GET',
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '/Personnel/GetAllPersonnel',
            success: function (data) {
                $("#divLoadPersonnelDetails").html(data);
            },
            error: function () {
                alert('There was a problem while trying to process your request. Please try again!')
            }
        });
    }

    function SavePersonnelData() {
        var formData = new FormData;
        formData.append("PersonnelName", $("#txtPersonnelName").val());
        formData.append("PersonnelTypeId", $("#ddPersonnelTypeId").val());
        formData.append("WorkingFrom", $("#txtWorkingFrom").val());

        $.ajax({
            async: true,
            type: 'POST',
            contentType: false,
            processData: false,
            data: formData,
            success: function (data) {
                if (data.success === true) {
                    alert(data.message);
                    ResetPersonnelData();
                }
            },
            error: function () {
                alert('There was a problem while trying to process your request. Please try again!');
            }
        });
    }

    function ResetPersonnelData() {
        $("#txtPersonnelName").val('');
        $("#ddPersonnelTypeId").val('');
        $("#txtWorkingFrom").val('');
        $("#txtPersonnelName").focus();
    }
</script>

<div style="margin-top: 50px">
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#divAddPersonnel" data-backdrop="static" data-keyboard="false">Add Personnel</button>
</div>

<div id="divAddPersonnel" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Personnel</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    @*<div class="form-group">
                        @Html.LabelFor(model => model.PersonnelId)
                        @Html.TextBoxFor(model => model.PersonnelId, new { @class = "form-control" })
                    </div>*@
                    <div class="form-group">
                        @Html.LabelFor(model => model.PersonnelName)
                        @Html.TextBoxFor(model => model.PersonnelName, new { @class = "form-control", id= "txtPersonnelName" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.PersonnelTypeId)
                        @Html.DropDownListFor(model => model.PersonnelTypeId, Model.ListOfPersonnelTypes, new { @class = "form-control" , id= "ddPersonnelTypeId" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.WorkingFrom)
                        @Html.EditorFor(expression: model => model.WorkingFrom, additionalViewData: new { htmlAttributes = new { @readonly = "true", Value = Model.WorkingFrom.ToString(format: "dd-MMM-yyyy"), @class = "form-control datepicker", @id = "txtWorkingFrom" } })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="btnSave" type="button" class="btn btn-success">Save</button>&nbsp;
                <button type="button" data-dismiss="modal" class="btn btn-danger">Close</button>
            </div>
        </div>
    </div>
</div>
<div style="margin-top: 70px"></div>
<div id="divLoadPersonnelDetails">

</div>