@model PawPaw.ViewModel.ServicesViewModel   
@{
    ViewBag.Title = "Service";
}

<div style="margin-top: 50px">
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#divAddService" data-backdrop="static" data-keyboard="false">Add Service</button>
</div>

<div id="divAddService" class="modal fade" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Services</h4>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="form-group">
                        @Html.LabelFor(model => model.ServicePrice)
                        @Html.TextBoxFor(model => model.ServicePrice, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ServiceTypeId)
                        @Html.DropDownListFor(model => model.ServiceTypeId, Model.ListOfServiceTypes, new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.DoctorStatusId)
                        @Html.DropDownListFor(model => model.DoctorStatusId, Model.ListOfDoctorStatus,new { @class = "form-control" })
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(model => model.ServiceDescription)
                        @Html.TextBoxFor(model => model.ServiceDescription, new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success">Save</button>&nbsp;
                <button type="button" data-dismiss="modal" class="btn btn-danger">Close</button>
            </div>
        </div>
    </div>
</div>